# 复制为 .env 或直接设置环境变量后运行
# 当前后端使用 DashScope(Spring AI Alibaba)，必填
DASHSCOPE_API_KEY=sk-xxx

# 用户自持 API Key 的 AES-256-GCM 加密口令（生产必填，任意长度随机串；丢失将无法解密已存用户 Key）
LLM_KEY_AES_SECRET=

# 对象存储（RustFS，S3 协议兼容 MinIO）
# endpoint 带协议；容器内互访用服务名，例如 http://rustfs:9000
RUSTFS_ENDPOINT=http://localhost:9000
# 预签名 URL 给浏览器用，必须是公网可解析地址（内网 http://rustfs:9000 签出来的地址客户端解析不了）
# 线上示例：https://api.veythcog.top （Nginx 把 /wallpapers/ 等桶路径原样反代到 127.0.0.1:9000）
RUSTFS_PUBLIC_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_REGION=us-east-1
