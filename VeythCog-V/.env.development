# 开发环境配置
# 复制为 .env.local 并填实际值（.env.local 已在 .gitignore 中）

# 后端 API 地址（业务后端：对话/知识库/数据库查询代理）
# 后端 vc-app 实际监听 8123（server.port=8123，context-path=/api），与 application.yml 保持一致
VITE_API_BASE=http://localhost:8123/api

# 大模型 API 地址（OpenAI 兼容协议，可换成自己的中转）
VITE_LLM_BASE=https://api.openai.com/v1

# 飞书开放平台 App ID（OAuth 登录 / 笔记集成）
VITE_LARK_APP_ID=

# 应用名称
VITE_APP_NAME=My Workspace

# 是否启用 mock 模式（true 时不发真实请求，走本地 mock）
VITE_USE_MOCK=true
