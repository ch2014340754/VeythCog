<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vc.knowledge.mapper.KnowledgeDocMapper">

    <resultMap id="KnowledgeDocMap" type="com.vc.knowledge.entity.KnowledgeDoc">
        <id property="id" column="id"/>
        <result property="libType" column="lib_type"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="tags" column="tags" typeHandler="com.vc.knowledge.handler.StringArrayTypeHandler"/>
        <result property="blockData" column="block_data"/>
        <result property="markdownText" column="markdown_text"/>
        <result property="isVectorized" column="is_vectorized"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <select id="selectDocList" resultMap="KnowledgeDocMap">
        SELECT id, lib_type, title, summary, tags, block_data, markdown_text,
               is_vectorized, created_at, updated_at, deleted
        FROM knowledge_doc
        WHERE deleted = false
          AND lib_type = #{libType}
        <if test="keyword != null and keyword != ''">
          AND to_tsvector('simple',
                title || ' ' || coalesce(summary, '') || ' ' || coalesce(markdown_text, ''))
              @@ plainto_tsquery('simple', #{keyword})
        </if>
        <if test="tag != null and tag != ''">
          AND #{tag} = ANY(tags)
        </if>
        ORDER BY
        <choose>
            <when test="sortField == 'createdAt'">created_at</when>
            <when test="sortField == 'title'">title</when>
            <otherwise>updated_at</otherwise>
        </choose>
        <choose>
            <when test="sortOrder == 'ascend'">ASC</when>
            <otherwise>DESC</otherwise>
        </choose>
    </select>
</mapper>
