<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vc</groupId>
        <artifactId>veythcog-c</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>vc-knowledge</artifactId>
    <name>vc-knowledge</name>
    <description>知识库域：上传 / 解析 / 分块 / Embedding / 检索（库，无 Controller）</description>

    <dependencies>
        <!-- 公共基础 -->
        <dependency>
            <groupId>com.vc</groupId>
            <artifactId>vc-common</artifactId>
        </dependency>
        <!-- MyBatis-Plus：知识库域数据访问（PostgreSQL + pgvector），替代 JPA -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- PostgreSQL 驱动：VectorTypeHandler 依赖 PGobject -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- 参数校验：@NotBlank / @NotEmpty（jakarta.validation） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 阿里百炼（DashScope）起步：提供 EmbeddingModel Bean（向量化/检索用） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>
    </dependencies>
</project>
