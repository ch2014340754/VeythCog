<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vc</groupId>
        <artifactId>veythcog-c</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>vc-app</artifactId>
    <name>vc-app</name>
    <description>唯一可运行应用：鉴权 / Web Controller / 系统管理 / RAG 编排，组装各域模块</description>

    <dependencies>
        <!-- 内部域模块（dashscope / openai 由 vc-llm 传递） -->
        <dependency>
            <groupId>com.vc</groupId>
            <artifactId>vc-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vc</groupId>
            <artifactId>vc-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vc</groupId>
            <artifactId>vc-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vc</groupId>
            <artifactId>vc-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vc</groupId>
            <artifactId>vc-nav</artifactId>
        </dependency>
        <!-- 管理域：系统监控采集/聚合、会话、模型目录管理 -->
        <dependency>
            <groupId>com.vc</groupId>
            <artifactId>vc-admin</artifactId>
        </dependency>

        <!-- Web / 安全 / 校验 / 持久化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL 驱动 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- 接口文档：knife4j-next（社区 fork）+ springdoc -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- JWT（jjwt 0.12.x） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
